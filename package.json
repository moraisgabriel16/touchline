{
  "name": "touchline-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test web/tests/domain.test.ts web/tests/tilesets.test.mjs web/tests/football.test.mjs web/tests/characters.test.mjs",
    "assets:pack": "node tools/pack-tilesets.mjs",
    "assets:football": "node tools/pack-football.mjs",
    "test:e2e": "npm run build && playwright test",
    "assets:characters": "node tools/pack-characters-v2.mjs",
    "assets:training": "node tools/pack-training.mjs",
    "assets:characters:v2": "node tools/pack-characters-v2.mjs",
    "assets:characters:legacy": "node tools/pack-characters.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
